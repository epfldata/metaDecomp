@article{birler_optimizing_2025,
    title = {Optimizing Linearized Join Enumeration by Adapting to the Query Structure},
    url = {https://dl.gi.de/handle/20.500.12116/45871},
    doi = {10.18420/BTW2025-09},
    abstract = {In database systems, join enumeration is a critical but NP-hard problem, especially challenging for queries with a large number of joins, as often found in graph workloads. To manage this complexity, some state-of-the-art methods reduce the search space by employing query graph linearization. However, even after linearization, join enumeration still has cubic runtime, which can be ineﬃcient for very large queries. We propose an improved enumeration algorithm that dynamically adapts to the query graph structure, avoiding the generation of invalid or redundant plans. This reduces the time complexity for star queries from O (��3) to O (�� log ��) and enables the optimization of general tree queries of thousands of joins within seconds.},
    language = {en},
    urldate = {2025-03-21},
    author = {Birler, Altan and Stoian, Mihail and Neumann, Thomas},
    year = {2025},
    journal = {Datenbanksysteme für Business, Technologie und Web (BTW 2025)},
    pages = {171--194},
    publisher = {Gesellschaft für Informatik},
    location = {Bonn}
}
